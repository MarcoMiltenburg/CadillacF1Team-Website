        Application("DatabaseConnectString") = "Provider=SQLOLEDB;Data Source=DEV4\DEV4;DATABASE=CadillacF1Team;User Id=xlpics_cadillacf1team_anonymous;Password=jwvjvx7XV1wOrcWMNxHffS!x;Connect Timeout=3;network library=dbmssocn;"
        Application("MailPickupDirectory") = "C:\Inetpub\Mailroot\Pickup"

        Application("SessionCookieDomain") = ""
